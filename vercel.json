{
  "installCommand": "sh scripts/vercel-install.sh",
  "buildCommand": "pnpm --dir frontend/app exec tsx scripts/build.ts --renderer-only",
  "outputDirectory": "frontend/app/dist",
  "framework": "vue",
  "rewrites": [
    { "source": "/dexpaprika/:path*", "destination": "https://api.dexpaprika.com/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
