{
  "installCommand": "sh scripts/vercel-install.sh",
  "buildCommand": "sh scripts/vercel-build.sh",
  "outputDirectory": "frontend/app/dist",
  "framework": "vue",
  "rewrites": [
    { "source": "/dexpaprika/:path*", "destination": "https://api.dexpaprika.com/:path*" },
    { "source": "/docs", "destination": "/docs/index.html" },
    { "source": "/docs/:path*", "destination": "/docs/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
